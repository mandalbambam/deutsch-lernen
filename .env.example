# Copy to .env.local (local) or add as Environment Variables on Vercel.
# Everything here is optional — the app works fully without AI.

# Free Gemini API key from https://aistudio.google.com/apikey (do not enable billing)
GEMINI_API_KEY=

# Models (defaults shown); overloaded, retired or exhausted models fall back automatically
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_LITE_MODEL=gemini-3.5-flash-lite

# Protects your free quota when the app is deployed publicly; enter it in Settings → AI features
# APP_PASSPHRASE=

# Canned AI answers for trying the screens / running tests without a key
# GEMINI_MOCK=1
